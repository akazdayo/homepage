{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "build": {
    "command": "pnpm build",
    "watch_dir": "src",
  },
  "cache": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "PRESENTATIONS_SOURCE_URL": "https://akazdayo.github.io/presentations/.well-known/presentations.json",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
