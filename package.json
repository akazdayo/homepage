    "test": "vp test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.90",
    "astro-icon": "^1.1.5",
    "daisyui": "^5.6.18",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.110.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
