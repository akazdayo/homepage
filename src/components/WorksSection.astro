---
const featuredWork = {
  year: "2025",
  category: "Team project",
  title: "MRSTUDY",
  description:
    "チームで制作したプロダクト。技育博2025 Vol.5で、2社から企業賞を受賞しました。",
  awards: [
    "株式会社サイバーエージェント賞",
    "ウイングアーク1st株式会社賞",
  ],
};

const otherWorks = [
  {
    year: "2026",
    category: "Image tool",
    title: "PixelArt-Converter",
    description:
      "画像を好みのカラーパレットでピクセルアートへ変換できるツール。変換処理の一部をRustで実装しています。",
    achievement: "動くWebアプリコンテスト 2025 冬 優秀賞",
    technologies: ["Python", "Rust", "Streamlit"],
    href: "https://pixelart.streamlit.app/",
    linkLabel: "作品を開く",
    preview: "pixelart",
  },
  {
    year: "2025",
    category: "LLM framework",
    title: "Independent LLM Agents",
    description:
      "独立したLLMエージェントを複数体連携させ、会話できるバックエンドフレームワーク。",
    achievement: "未踏ジュニア2025 スーパークリエータ認定",
    technologies: ["TypeScript", "Rust", "libp2p", "LLM"],
    href: "https://github.com/akazdayo",
    linkLabel: "GitHubを見る",
    preview: "agents",
  },
] as const;
---

<section
  id="works"
  class="mx-auto flex w-full max-w-none justify-center bg-white px-6 py-16 text-left sm:px-10 min-[900px]:px-[clamp(3.5rem,6vw,7rem)] min-[900px]:py-[clamp(4rem,8vh,7rem)]"
  aria-labelledby="works-section-title"
>
  <div
    class="flex w-full max-w-none flex-col min-[900px]:px-[clamp(1rem,3vw,3rem)]"
  >
    <div
      class="flex items-end justify-between gap-6 border-b border-black/10 pb-5"
    >
      <div>
        <p class="m-0 text-sm text-gray-500">Works / selected</p>
        <h2
          id="works-section-title"
          class="mt-3 mb-0 text-3xl leading-tight font-normal"
        >
          作品
        </h2>
      </div>
      <span class="hidden pb-1 text-xs text-gray-500 sm:block">3 projects</span>
    </div>

    <article
      class="grid gap-8 border-b border-black/10 py-10 min-[900px]:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] min-[900px]:items-stretch min-[900px]:gap-[clamp(2.5rem,5vw,6rem)] min-[900px]:py-14"
    >
      <div
        class="work-preview featured-preview min-h-64 overflow-hidden rounded-3xl bg-[#f1f0eb] sm:min-h-80"
        aria-hidden="true"
      >
        <div class="featured-preview__header">
          <span>SELECTED WORK</span>
          <span>01 / 03</span>
        </div>
        <div class="featured-preview__mark">
          <span class="featured-preview__eyebrow">PROJECT 2025</span>
          <span class="featured-preview__title">MR<br />STUDY</span>
        </div>
        <div class="featured-preview__footer">
          <span>TEAM DEVELOPMENT</span>
          <span class="featured-preview__dot"></span>
          <span>AWARD WINNER</span>
        </div>
      </div>

      <div class="flex min-w-0 flex-col justify-center">
        <p class="m-0 text-xs tracking-[0.16em] text-gray-500 uppercase">
          {featuredWork.year} / {featuredWork.category}
        </p>
        <h3
          class="mt-4 mb-0 text-[clamp(2rem,4vw,3.75rem)] leading-none font-normal tracking-[-0.04em]"
        >
          {featuredWork.title}
        </h3>
        <p class="mt-6 mb-0 max-w-xl text-sm leading-7 text-gray-700">
          {featuredWork.description}
        </p>

        <div class="mt-8 border-l-2 border-black pl-4">
          <p class="m-0 text-xs tracking-[0.12em] text-gray-500 uppercase">
            Awards
          </p>
          <ul class="mt-2 mb-0 list-none space-y-1 p-0 text-sm leading-6">
            {
              featuredWork.awards.map((award) => (
                <li>{award}</li>
              ))
            }
          </ul>
        </div>

        <a
          class="group mt-10 inline-flex w-fit items-center gap-3 text-sm text-black no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
          href="#career-section-title"
        >
          <span
            class="border-b border-black/30 pb-1 transition-colors group-hover:border-black"
          >
            受賞歴を見る
          </span>
          <span
            class="transition-transform group-hover:translate-x-0.5"
            aria-hidden="true">↓</span
          >
        </a>
      </div>
    </article>

    <div class="grid grid-cols-1 min-[760px]:grid-cols-2">
      {
        otherWorks.map((work, index) => (
          <article
            class:list={[
              "flex min-w-0 flex-col py-10 min-[760px]:py-12",
              index === 0
                ? "border-b border-black/10 min-[760px]:border-r min-[760px]:border-b-0 min-[760px]:pr-8 min-[900px]:pr-[clamp(2rem,4vw,4.5rem)]"
                : "min-[760px]:pl-8 min-[900px]:pl-[clamp(2rem,4vw,4.5rem)]",
            ]}
          >
            <div
              class:list={[
                "work-preview relative aspect-[16/10] overflow-hidden rounded-2xl bg-[#f1f0eb]",
                `${work.preview}-preview`,
              ]}
              aria-hidden="true"
            >
              {work.preview === "pixelart" ? (
                <div class="pixelart-preview__inner">
                  <div class="pixelart-preview__bar">
                    <span>IMAGE</span>
                    <span>PIXEL</span>
                  </div>
                  <div class="pixelart-preview__stage">
                    <div class="pixelart-preview__source">
                      <span class="pixelart-preview__sun" />
                      <span class="pixelart-preview__mountain pixelart-preview__mountain--back" />
                      <span class="pixelart-preview__mountain pixelart-preview__mountain--front" />
                    </div>
                    <span class="pixelart-preview__arrow">→</span>
                    <div class="pixelart-preview__result">
                      {Array.from({ length: 48 }).map(() => <span />)}
                    </div>
                  </div>
                </div>
              ) : (
                <div class="agents-preview__inner">
                  <p>INDEPENDENT AGENTS / NETWORK</p>
                  <div class="agents-preview__network">
                    <span class="agents-preview__line agents-preview__line--one" />
                    <span class="agents-preview__line agents-preview__line--two" />
                    <span class="agents-preview__line agents-preview__line--three" />
                    <span class="agents-preview__node agents-preview__node--one">
                      01
                    </span>
                    <span class="agents-preview__node agents-preview__node--two">
                      02
                    </span>
                    <span class="agents-preview__node agents-preview__node--three">
                      03
                    </span>
                    <span class="agents-preview__center">LLM</span>
                  </div>
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col pt-6">
              <p class="m-0 text-xs tracking-[0.16em] text-gray-500 uppercase">
                {work.year} / {work.category}
              </p>
              <h3 class="mt-3 mb-0 text-2xl leading-tight font-normal">
                {work.title}
              </h3>
              <p class="mt-4 mb-0 text-sm leading-7 text-gray-700">
                {work.description}
              </p>
              <p
                class="mt-5 mb-0 rounded-xl bg-[#f6f5f1] px-4 py-3 text-xs leading-5 text-gray-700"
              >
                {work.achievement}
              </p>
              <ul
                class="mt-5 mb-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-xs text-gray-500"
                aria-label={`${work.title}の使用技術`}
              >
                {work.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
              <a
                class="group mt-8 inline-flex w-fit items-center gap-3 text-sm text-black no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
                href={work.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="border-b border-black/30 pb-1 transition-colors group-hover:border-black"
                >
                  {work.linkLabel}
                </span>
                <span
                  class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  aria-hidden="true">↗</span
                >
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-preview {
    isolation: isolate;
  }

  .featured-preview {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .featured-preview::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(18 18 18 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(18 18 18 / 7%) 1px, transparent 1px);
    background-size: 2rem 2rem;
    content: "";
    mask-image: linear-gradient(to bottom right, black, transparent 75%);
  }

  .featured-preview__header,
  .featured-preview__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
  }

  .featured-preview__footer {
    justify-content: flex-start;
  }

  .featured-preview__dot {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: #121212;
  }

  .featured-preview__mark {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-inline: clamp(0rem, 2vw, 2rem);
  }

  .featured-preview__eyebrow {
    border-block-start: 1px solid #121212;
    padding-block-start: 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }

  .featured-preview__title {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.75;
    letter-spacing: -0.09em;
    text-align: right;
  }

  .pixelart-preview__inner,
  .agents-preview__inner {
    position: absolute;
    inset: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .pixelart-preview__inner {
    display: flex;
    flex-direction: column;
  }

  .pixelart-preview__bar,
  .agents-preview__inner > p {
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
  }

  .pixelart-preview__stage {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.25rem);
  }

  .pixelart-preview__source,
  .pixelart-preview__result {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(18 18 18 / 12%);
    background: #dddcd4;
  }

  .pixelart-preview__sun {
    position: absolute;
    top: 18%;
    right: 16%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: #f3f0d8;
  }

  .pixelart-preview__mountain {
    position: absolute;
    right: -5%;
    bottom: -20%;
    width: 85%;
    aspect-ratio: 1;
    rotate: 45deg;
    background: #8f9b89;
  }

  .pixelart-preview__mountain--front {
    right: 30%;
    bottom: -35%;
    background: #303d35;
  }

  .pixelart-preview__arrow {
    font-size: 0.875rem;
  }

  .pixelart-preview__result {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(6, 1fr);
  }

  .pixelart-preview__result span {
    background: #303d35;
  }

  .pixelart-preview__result span:nth-child(3n) {
    background: #8f9b89;
  }

  .pixelart-preview__result span:nth-child(5n) {
    background: #d7d6ca;
  }

  .pixelart-preview__result span:nth-child(11n),
  .pixelart-preview__result span:nth-child(13n) {
    background: #f3f0d8;
  }

  .agents-preview__inner {
    display: flex;
    flex-direction: column;
  }

  .agents-preview__network {
    position: relative;
    flex: 1;
  }

  .agents-preview__center,
  .agents-preview__node {
    position: absolute;
    display: grid;
    place-items: center;
    width: clamp(2.25rem, 6vw, 3.5rem);
    aspect-ratio: 1;
    border: 1px solid rgb(18 18 18 / 25%);
    border-radius: 999px;
    background: #f1f0eb;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }

  .agents-preview__center {
    top: 50%;
    left: 50%;
    z-index: 2;
    border-color: #121212;
    background: #121212;
    color: white;
    translate: -50% -50%;
  }

  .agents-preview__node--one {
    top: 15%;
    left: 12%;
  }

  .agents-preview__node--two {
    top: 18%;
    right: 10%;
  }

  .agents-preview__node--three {
    bottom: 9%;
    left: 22%;
  }

  .agents-preview__line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38%;
    height: 1px;
    background: rgb(18 18 18 / 22%);
    transform-origin: left center;
  }

  .agents-preview__line--one {
    rotate: 210deg;
  }

  .agents-preview__line--two {
    rotate: -30deg;
  }

  .agents-preview__line--three {
    rotate: 140deg;
  }

  @media (max-width: 520px) {
    .featured-preview__mark {
      flex-direction: column;
      gap: 1rem;
    }

    .featured-preview__title {
      align-self: flex-end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-preview {
      transition: transform 300ms ease;
    }

    article:hover .work-preview {
      transform: translateY(-0.2rem);
    }
  }
</style>
