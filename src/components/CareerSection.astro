---
type Career = {
  period: Date;
  title: string;
  description: string;
}[];

const createPeriod = (year: number, month = 1, day = 1) =>
  new Date(Date.UTC(year, month - 1, day));
const formatPeriod = (period: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(period);

const career: Career = [
  {
    period: createPeriod(2026, 6),
    title: "SecHack365 2026年度 世界観駆動コース採択",
    description: "SecHack365の2026年度世界観駆動コースに採択されました。",
  },
  {
    period: createPeriod(2026, 2, 17),
    title: "動くWebアプリコンテスト 2025 冬",
    description:
      "角川ドワンゴ学園のコンテストで、作品「PixelArt-Converter」により優秀賞を受賞。",
  },
  {
    period: createPeriod(2025, 12, 7),
    title: "技育博2025 Vol. 5",
    description:
      "サポーターズ主催。作品「MRSTUDY」で株式会社サイバーエージェント賞、ウイングアーク1st株式会社賞を受賞。",
  },
  {
    period: createPeriod(2025, 11, 30),
    title: "未踏ジュニア スーパークリエータ認定",
    description:
      "Mitou Junior.の2025年度でスーパークリエータに認定されました。",
  },
  {
    period: createPeriod(2025, 6),
    title: "Hack 1 グランプリ",
    description: "HackathonのHack 1 グランプリで日テレ賞を受賞。",
  },
  {
    period: createPeriod(2025, 6),
    title: "Coyote AI Competition",
    description:
      "名古屋大学非公認サークルjack主催のCoyote AI Competitionで準優勝。AIの社会実装をテーマに企画・開発。",
  },
  {
    period: createPeriod(2025, 5),
    title: "未踏ジュニア 25年度採択",
    description:
      "未踏ジュニアに採択。独立したLLMエージェントを複数体連携させ、会話することができるバックエンドフレームワークを開発。",
  },
  {
    period: createPeriod(2025, 5),
    title: "Hack with AI",
    description: "Hackathonで、生成AIを活用したプロダクトにより準優勝。",
  },
  {
    period: createPeriod(2025, 3),
    title: "Garage Challenge 5th",
    description: "HackathonのGarage Challenge 5thに参加。",
  },
  {
    period: createPeriod(2025, 2, 15),
    title: "Open Hack U 2025 Nagoya",
    description:
      "Hackathonで最優秀賞、HappyHacking賞を受賞。LLMを用いた物理問題可視化Webアプリを開発。",
  },
  {
    period: createPeriod(2025, 1),
    title: "Startup Dragongate 2025",
    description: "HackathonのStartup Dragongate 2025に参加。",
  },
  {
    period: createPeriod(2025, 4, 1),
    title: "N高等学校",
    description: "",
  },
  {
    period: createPeriod(2024, 12),
    title: "Hack the Nagoya",
    description: "HackathonのHack the Nagoyaに参加。",
  },
  {
    period: createPeriod(2023),
    title: "アプリ甲子園",
    description:
      "アプリ甲子園23年度で一次選考を突破し、プロダクトの完成度を評価された。",
  },
  {
    period: createPeriod(2025, 3, 31),
    title: "N中等部",
    description: "N中等部を卒業。オンラインでプログラミングを沢山学びました。",
  },
];

const sortedCareer = [...career].sort(
  (a, b) => b.period.getTime() - a.period.getTime(),
);

const visibleCareerCount = 4;
---

<section
  id="career"
  class="mx-auto flex min-h-[70vh] w-full max-w-none items-center justify-center px-6 py-10 text-left sm:px-10 min-[900px]:px-[clamp(3.5rem,6vw,7rem)] min-[900px]:py-[clamp(2.5rem,6vh,5rem)]"
  aria-labelledby="career-section-title"
  data-career-section
>
  <div
    class="flex w-full max-w-none flex-col min-[900px]:px-[clamp(1rem,3vw,3rem)]"
  >
    <div
      class="flex flex-none items-end justify-between gap-6 border-b border-black/10 pb-5"
    >
      <div>
        <p class="m-0 text-sm text-gray-500">Profile / history</p>
        <h2
          id="career-section-title"
          class="mt-3 mb-0 text-3xl leading-tight font-normal"
        >
          経歴
        </h2>
      </div>
      <span class="hidden pb-1 text-xs text-gray-500 sm:block"
        >{sortedCareer.length} entries</span
      >
    </div>

    <div>
      <ol
        id="career-list"
        class="m-0 list-none border-l border-black/15 pt-8 pl-6 sm:pl-8"
        aria-label="経歴"
      >
        {
          sortedCareer.map(({ period, title, description }, index) => {
            const label = formatPeriod(period);
            const isExtra = index >= visibleCareerCount;

            return (
              <li
                class="career-item relative pb-10"
                data-career-extra={isExtra ? "" : undefined}
                hidden={isExtra}
              >
                <span
                  class="absolute -left-[calc(1.5rem+5px)] top-1 size-2.5 rounded-full bg-[#121212] ring-4 ring-white sm:-left-[calc(2rem+5px)]"
                  aria-hidden="true"
                />
                <p class="m-0 text-xs tracking-[0.18em] text-gray-500 uppercase">
                  {label}
                </p>
                <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="m-0 text-xl leading-tight font-normal">{title}</h3>
                </div>
                {description && (
                  <p class="m-0 mt-3 text-sm leading-7 text-gray-700">
                    {description}
                  </p>
                )}
              </li>
            );
          })
        }
      </ol>

      <p
        class="m-0 py-5 text-center text-xs text-gray-500"
        data-career-ending
        hidden
      >
        まだまだ、これから。
      </p>

      <div class="flex justify-center border-t border-black/10 pt-6">
        <button
          type="button"
          class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-black/15 bg-white px-5 py-2.5 text-sm transition-colors hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
          aria-controls="career-list"
          aria-expanded="false"
          data-career-toggle
        >
          <span class="group-aria-expanded:hidden">すべての経歴を見る</span>
          <span class="hidden group-aria-expanded:inline">経歴を閉じる</span>
          <svg
            class="size-4 transition-transform duration-300 group-aria-expanded:rotate-180"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="m5 7.5 5 5 5-5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .career-item:not([hidden]) {
    animation: reveal-career 300ms ease-out both;
  }

  @keyframes reveal-career {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-item:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-career-section]")
    .forEach((section) => {
      const toggle = section.querySelector<HTMLButtonElement>(
        "[data-career-toggle]",
      );
      const extraItems = section.querySelectorAll<HTMLElement>(
        "[data-career-extra]",
      );
      const ending = section.querySelector<HTMLElement>("[data-career-ending]");

      toggle?.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";

        toggle.setAttribute("aria-expanded", String(!isExpanded));
        extraItems.forEach((item) => {
          item.hidden = isExpanded;
        });
        if (ending) ending.hidden = isExpanded;
      });
    });
</script>
