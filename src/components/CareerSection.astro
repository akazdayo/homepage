---
type Career = {
  period: string,
  title: string,
  label: string,
  description: string,
}[];

const career: Career = [
  {
    period: "2025",
    title: "未踏ジュニア'25",
    label: "スーパークリエータ",
    description: "自分の興味を起点に、技術で形にするプロジェクトに取り組んでいます。",
  },
  {
    period: "現在",
    title: "N高等学校",
    label: "2年",
    description: "学びながら、ソフトウェアやコンピュータの仕組みを深掘りしています。",
  },
  {
    period: "日々",
    title: "個人開発",
    label: "つくって、試す",
    description: "Rust・TypeScript・Pythonを使って、気になったものを小さく実装しています。",
  },
  {
    period: "これから",
    title: "もっと遠くへ",
    label: "進行中",
    description: "NixOSやLinuxを含めた、自分らしい開発環境づくりも続けています。",
  },
] as const;
---

<section
  class="mx-auto flex h-[70vh] min-h-[70vh] w-full max-w-none items-center justify-center overflow-hidden px-6 py-10 text-left sm:px-10 min-[900px]:px-[clamp(3.5rem,6vw,7rem)] min-[900px]:py-[clamp(2.5rem,6vh,5rem)]"
  aria-labelledby="career-section-title"
>
  <div
    class="flex h-full w-full max-w-none min-h-0 flex-col min-[900px]:px-[clamp(1rem,3vw,3rem)]"
  >
    <div class="flex flex-none items-end justify-between gap-6 border-b border-black/10 pb-5">
      <div>
        <p class="m-0 text-sm text-gray-500">Profile / history</p>
        <h2 id="career-section-title" class="mt-3 mb-0 text-3xl leading-tight font-normal">
          経歴
        </h2>
      </div>
      <span class="hidden pb-1 text-xs text-gray-500 sm:block">scroll to explore</span>
    </div>

    <div
      class="career-scroll min-h-0 flex-1 overflow-y-auto overscroll-contain scroll-smooth pr-2"
      tabindex="0"
      aria-label="あかずの経歴"
    >
      <ol class="m-0 list-none border-l border-black/15 py-8 pl-6 sm:pl-8">
        {
          career.map(({ period, title, label, description }) => (
            <li class="relative pb-10 last:pb-2">
              <span
                class="absolute -left-[calc(1.5rem+5px)] top-1 size-2.5 rounded-full bg-[#121212] ring-4 ring-white sm:-left-[calc(2rem+5px)]"
                aria-hidden="true"
              ></span>
              <p class="m-0 text-xs tracking-[0.18em] text-gray-500 uppercase">{period}</p>
              <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="m-0 text-xl leading-tight font-normal">{title}</h3>
                <span class="text-sm text-gray-500">{label}</span>
              </div>
              <p class="m-0 mt-3 text-sm leading-7 text-gray-700">{description}</p>
            </li>
          ))
        }
      </ol>

      <p class="m-0 border-t border-black/10 py-5 text-center text-xs text-gray-500">
        まだまだ、これから。
      </p>
    </div>
  </div>
</section>

<style>
  .career-scroll {
    scrollbar-color: rgb(0 0 0 / 0.25) transparent;
    scrollbar-width: thin;
  }

  .career-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .career-scroll::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgb(0 0 0 / 0.25);
  }

  .career-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
</style>
