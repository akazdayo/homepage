---
type Career = {
  period: Date;
  title: string;
  description: string;
}[];

const createPeriod = (year: number, month = 1, day = 1) => new Date(Date.UTC(year, month - 1, day));
const formatPeriod = (period: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(period);

const career: Career = [
  {
    period: createPeriod(2026, 2, 17),
    title: "動くWebアプリコンテスト 2025 冬",
    description: "角川ドワンゴ学園のコンテストで、作品「PixelArt-Converter」により優秀賞を受賞。",
  },
  {
    period: createPeriod(2025, 12, 7),
    title: "技育博2025 Vol. 5",
    description: "サポーターズ主催。作品「MRSTUDY」で株式会社サイバーエージェント賞、ウイングアーク1st株式会社賞を受賞。",
  },
  {
    period: createPeriod(2025, 11, 30),
    title: "未踏ジュニア スーパークリエータ認定",
    description: "Mitou Junior.の2025年度でスーパークリエータに認定されました。",
  },
  {
    period: createPeriod(2025, 6),
    title: "Hack 1 グランプリ",
    description: "HackathonのHack 1 グランプリで日テレ賞を受賞。",
  },
  {
    period: createPeriod(2025, 6),
    title: "Coyote AI Competition",
    description:
      "名古屋大学非公認サークルjack主催のCoyote AI Competitionで準優勝。AIの社会実装をテーマに企画・開発。",
  },
  {
    period: createPeriod(2025, 5),
    title: "未踏ジュニア 25年度採択",
    description:
      "未踏ジュニアに採択。独立したLLMエージェントを複数体連携させ、会話することができるバックエンドフレームワークを開発。",
  },
  {
    period: createPeriod(2025, 5),
    title: "Hack with AI",
    description: "Hackathonで、生成AIを活用したプロダクトにより準優勝。",
  },
  {
    period: createPeriod(2025, 3),
    title: "Garage Challenge 5th",
    description: "HackathonのGarage Challenge 5thに参加。",
  },
  {
    period: createPeriod(2025, 2, 15),
    title: "Open Hack U 2025 Nagoya",
    description: "Hackathonで最優秀賞、HappyHacking賞を受賞。LLMを用いた物理問題可視化Webアプリを開発。",
  },
  {
    period: createPeriod(2025, 1),
    title: "Startup Dragongate 2025",
    description: "HackathonのStartup Dragongate 2025に参加。",
  },
  {
    period: createPeriod(2025, 4, 1),
    title: "N高等学校",
    description: "",
  },
  {
    period: createPeriod(2024, 12),
    title: "Hack the Nagoya",
    description: "HackathonのHack the Nagoyaに参加。",
  },
  {
    period: createPeriod(2023),
    title: "アプリ甲子園",
    description: "アプリ甲子園23年度で一次選考を突破し、プロダクトの完成度を評価された。",
  },
  {
    period: createPeriod(2025, 3, 31),
    title: "N中等部",
    description: "N中等部を卒業。オンラインでプログラミングを沢山学びました。",
  },
];

const sortedCareer = [...career].sort(
  (a, b) => b.period.getTime() - a.period.getTime(),
);
---

<section
  class="mx-auto flex h-[70vh] min-h-[70vh] w-full max-w-none items-center justify-center overflow-hidden px-6 py-10 text-left sm:px-10 min-[900px]:px-[clamp(3.5rem,6vw,7rem)] min-[900px]:py-[clamp(2.5rem,6vh,5rem)]"
  aria-labelledby="career-section-title"
>
  <div
    class="flex h-full w-full max-w-none min-h-0 flex-col min-[900px]:px-[clamp(1rem,3vw,3rem)]"
  >
    <div class="flex flex-none items-end justify-between gap-6 border-b border-black/10 pb-5">
      <div>
        <p class="m-0 text-sm text-gray-500">Profile / history</p>
        <h2 id="career-section-title" class="mt-3 mb-0 text-3xl leading-tight font-normal">
          経歴
        </h2>
      </div>
      <span class="hidden pb-1 text-xs text-gray-500 sm:block">scroll to explore</span>
    </div>

    <div
      class="career-scroll min-h-0 flex-1 overflow-y-auto overscroll-contain scroll-smooth pr-2"
      tabindex="0"
      aria-label="経歴"
    >
      <ol class="m-0 list-none border-l border-black/15 py-8 pl-6 sm:pl-8">
        {
          sortedCareer.map(({ period, title, description }) => {
            const label = formatPeriod(period);

            return (
              <li class="relative pb-10 last:pb-2">
                <span
                  class="absolute -left-[calc(1.5rem+5px)] top-1 size-2.5 rounded-full bg-[#121212] ring-4 ring-white sm:-left-[calc(2rem+5px)]"
                  aria-hidden="true"
                ></span>
                <p class="m-0 text-xs tracking-[0.18em] text-gray-500 uppercase">{label}</p>
                <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="m-0 text-xl leading-tight font-normal">{title}</h3>
                </div>
                {description && (
                  <p class="m-0 mt-3 text-sm leading-7 text-gray-700">{description}</p>
                )}
              </li>
            );
          })
        }
      </ol>

      <p class="m-0 border-t border-black/10 py-5 text-center text-xs text-gray-500">
        まだまだ、これから。
      </p>
    </div>
  </div>
</section>

<style>
  .career-scroll {
    scrollbar-color: rgb(0 0 0 / 0.25) transparent;
    scrollbar-width: thin;
  }

  .career-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .career-scroll::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgb(0 0 0 / 0.25);
  }

  .career-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
</style>
