---
import DummySection from "../components/DummySection.astro";
import Footer from "../components/Footer.astro";
import SelfIntroduction from "../components/SelfIntroduction.astro";
import "../styles/global.css";

---

<!doctype html>
<html lang="ja" class="min-h-full w-full bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ほーむぺーじかも!" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
    />
    <title>あかずのほーむぺーじ!</title>
  </head>
  <body
    class="m-0 min-h-full w-full overflow-x-hidden bg-white font-['Klee_One',cursive] text-[#121212]"
  >
    <SelfIntroduction />
    <DummySection />
    <Footer />
  </body>
</html>
